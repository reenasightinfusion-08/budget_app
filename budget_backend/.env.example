PORT=3000
NODE_ENV=development
MONGODB_URI_LOCAL=mongodb://127.0.0.1:27017/budget_app
MONGODB_URI_ATLAS=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/budget_app

JWT_SECRET=change-me
EXPOSE_DEV_CODE=false
# Comma-separated OAuth client IDs; the Web client ID is the one the app passes as serverClientId
GOOGLE_CLIENT_IDS=

# Email codes. Leave SMTP_USER/SMTP_PASS blank in dev and codes print to the console
# (Gmail: use an App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Smart add. ai-hub reads bills, statements and spoken notes; without it the rules parser is used.
AI_HUB_URL=https://manifest-ai-central-indol.vercel.app
AI_HUB_SECRET=long_random_string_shared_with_ai_hub
SMART_ADD_DAILY_LIMIT=30
