import 'dart:math' as math;

import 'package:flutter/foundation.dart';
import 'package:flutter/widgets.dart';
import 'package:flutter_screenutil/flutter_screenutil.dart';

class AppLayout {
  const AppLayout._();

  /// Bottom space tab screens reserve so content scrolls clear of the floating nav bar.
  static const double navBarClearance = 110;

  static bool get isIOS => defaultTargetPlatform == TargetPlatform.iOS;

  /// Distance from the screen bottom to the floating nav bar. Android keeps its
  /// original offset; iOS tucks the bar just above the home indicator instead
  /// of stacking a full safe-area inset on top of the margin.
  static double navBarBottom(BuildContext context) {
    final inset = MediaQuery.paddingOf(context).bottom;
    return isIOS ? math.max(inset - 10.r, 12.h) : 16.h + inset;
  }

  /// Distance from the screen bottom to the add button, always above the nav bar.
  static double fabBottom(BuildContext context) =>
      isIOS ? navBarBottom(context) + 64.h + 14.h : 92.h;

  /// Bottom padding for tab content so it scrolls clear of the nav bar.
  static double navBarClearanceOf(BuildContext context) =>
      isIOS ? navBarBottom(context) + 64.h + 30.h : navBarClearance.h;
}
